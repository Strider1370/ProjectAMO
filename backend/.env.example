# ProjectAMO 백엔드 환경변수 예시. 실제 값은 .env(커밋 금지)에.

# 세션 서명 시크릿 — 운영 필수. 생성: openssl rand -hex 32
SESSION_SECRET=

# production 이면 쿠키 Secure 강제 + SESSION_SECRET 필수. 개발은 비워두거나 development.
NODE_ENV=development

# 개발용 CORS 허용 origin(프론트 dev 서버). 운영은 nginx 한 origin이라 불필요.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# 데이터/DB 경로(미설정 시 backend/data). projectamo.db 가 여기에 생성됨.
# DATA_PATH=

# KMA API Hub 키 분리. 기존 API_AUTH_KEY/KMA_AUTH_KEY만 설정해도 동작하지만,
# 역할별 신규 키를 발급받았다면 아래 두 값을 각각 설정한다.
# - KMA_RADAR_SATELLITE_AUTH_KEY: 레이더 HSR·UF 및 GK2A 위성(IR105/FOG/CI/CTPS)
# - KMA_KIM_NWP_AUTH_KEY: KIM 격자·KIM 지상풍·KTG 난류 예보
# KMA_AVIATION_AUTH_KEY는 METAR/TAF/SIGMET/AIRMET 등 기존 항공·일반 KMA 수집기에 사용한다.
# KMA_AVIATION_AUTH_KEY=
# KMA_RADAR_SATELLITE_AUTH_KEY=
# KMA_KIM_NWP_AUTH_KEY=
# KMA_RADAR_SATELLITE_ENABLED=0 # 일일 용량 초과 등으로 레이더·위성 전용 수집을 일시 중단

# #13 경로 예보변화 알림 — 텔레그램 발송(둘 다 있어야 발송, 없으면 인앱 저장만). @BotFather 발급.
# 딥링크는 FRONTEND_ORIGIN/?flight=<id> 사용.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 운영 텔레그램 알림이 5분마다 공개 TLS 인증서와 /api/health를 확인할 HTTPS 원본.
# 비우면 https://projectamo.co.kr 를 사용한다.
# OPS_MONITOR_ORIGIN=https://projectamo.co.kr

# Web Push (VAPID) — 앱을 꺼도 오는 브라우저 푸시. 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@projectamo.co.kr

# 기상이: 로그인 계정당 KST 하루 5질문, 실험실 기본 OFF. 서버 운영자 키만 사용.
# VITE_ 변수에 비밀을 넣지 않는다. 설정/대화 API로 키를 전송하거나 반환하지 않는다.
AMO_AI_ENABLED=0
# 앱 서버 및 독립 평가 CLI 전용. 브라우저에는 전달하지 않는다.
OPENAI_API_KEY=
AMO_AI_MODEL=
# 이전 개인 키 암호화 환경변수/DB는 보존 가능하나 운영자 키 모드에서는 사용하지 않는다.
# 모델에서 지원하는 경우만 지정: none/minimal/low/medium/high
# AMO_AI_REASONING_EFFORT=high
# 모델 호출당 추론+출력 토큰 상한(256..8192). 미설정 기본값은 1600.
# 2026-09-24 로컬 앱 승인 설정: gpt-6-luna / high / 3200. 호출/턴 상한은 별개.
# AMO_AI_MAX_OUTPUT_TOKENS=3200
