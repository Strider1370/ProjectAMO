limit_req_zone $binary_remote_addr zone=projectamo_api:10m rate=5r/s;

server {
  listen 443 ssl;
  server_name projectamo.co.kr www.projectamo.co.kr;

  ssl_certificate /etc/letsencrypt/live/projectamo.co.kr/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/projectamo.co.kr/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  root /opt/projectamo/current/frontend/dist;
  index index.html;

  gzip on;
  # 안 적으면 nginx 기본값은 1(가장 약함)이다. entry JS 기준 1,019KB로 나가던 것이
  # 6에서 869KB가 된다 — 느린 4G에서 첫 화면이 약 0.8초 빨라진다. 대가는 첫 방문자
  # 한 명당 서버 CPU 25ms(18ms→43ms). 9로 올려도 2KB밖에 안 줄어 CPU만 더 쓴다.
  gzip_comp_level 6;
  gzip_types text/plain text/css application/json application/javascript application/xml+rss image/svg+xml application/geo+json application/topo+json;
  gzip_min_length 1024;

  # Personal map JSON includes the original KML properties and compound geometries.
  # Match backend/src/maps/schema.js without increasing unrelated API limits.
  location ~ ^/api/me/maps(?:/|$) {
    client_max_body_size 5m;
    limit_req zone=projectamo_api burst=60 nodelay;
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    limit_req zone=projectamo_api burst=60 nodelay;

    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SQLite and private organization files must never bypass application authorization.
  location ~* "^/data/(?:backups|organization-files)(?:/|$)|^/data/.*\.(?:db|sqlite|sqlite3)(?:-(?:wal|shm|journal))?$" {
    return 404;
  }

  # These exact raw composites are read only by their point APIs.  They share
  # the active data root with browser frames, so deny them before the alias can
  # bypass backend/server.js's corresponding boundary.  Do not blanket-deny
  # .bin: terrain and other explicitly supported binary assets have different
  # consumers and contracts.
  location ~* "^/data/(?:satellite/convective/ctps_\d{12}|radar/echotop/echotop_\d{12})\.bin$" {
    return 404;
  }

  location /data/ {
    alias /opt/projectamo/shared/data/.active-data/;
    try_files $uri @projectamo_data_backend;
  }

  # Published frame names are immutable.  Keep this list synchronized with
  # backend/server.js:setGeneratedDataCacheHeaders because this direct alias
  # does not run Express middleware.
  location ~* "^/data/(radar/(?:echo_korea_\d{12}\.png|echotop/echotop_\d{12}\.webp|(?:wissdom/wissdom_\d+_\d{12}|qpf/qpf_\d{12}_p\d+)(?:_legend)?\.webp)|satellite/(?:sat_korea_\d{12}\.(?:png|webp)|convective/(?:ci_\d{12}\.geojson|ctps_\d{12}_(?:all|fl\d{3})\.webp))|sigwx_low/(?:fronts|clouds)_\d{10}\.png)$" {
    alias /opt/projectamo/shared/data/.active-data/$1;
    add_header Cache-Control "public, max-age=10800, immutable";
  }

  location ~* "^/data/(radar/(?:echo_meta|rainviewer_meta)\.json|radar/(?:hsr/hsr_meta|hci/hci_meta|wissdom/wissdom_meta|qpf/qpf_meta|echotop/echotop_meta)\.json|satellite/(?:sat_meta|convective/convective_meta)\.json|sigwx_low/(fronts_meta|clouds_meta)_\d{10}\.json)$" {
    alias /opt/projectamo/shared/data/.active-data/$1;
    add_header Cache-Control "no-cache";
  }

  # PDF.js workers are ES modules; browsers reject application/octet-stream.
  location ~* "^/assets/.*\.mjs$" {
    types { application/javascript mjs; }
    try_files $uri @projectamo_previous_mjs;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # The immediately preceding build remains available only for immutable
  # assets. This lets an already-open tab load its old lazy chunk after an
  # atomic dist swap; it never serves a previous index.html or runtime data.
  location ~* "^/assets/" {
    try_files $uri @projectamo_previous_asset;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location ~* "^/(data/navdata/|data/.*\.(geojson|topojson)|Symbols/)" {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location @projectamo_previous_mjs {
    root /opt/projectamo/current/frontend/dist.previous;
    types { application/javascript mjs; }
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location @projectamo_previous_asset {
    root /opt/projectamo/current/frontend/dist.previous;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location = /index.html {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri /index.html;
  }

  location @projectamo_data_backend {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name projectamo.co.kr www.projectamo.co.kr;
  return 301 https://$host$request_uri;
}
