{
  "name": "project-kma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:serve": "node scripts/projectamo-dev.mjs serve",
    "dev:test": "node scripts/projectamo-dev.mjs serve:test",
    "dev:no-nwp": "node scripts/projectamo-dev.mjs serve:no-nwp",
    "dev:contract": "npm --prefix frontend run dev:contract --",
    "dev:verify": "node scripts/projectamo-dev.mjs verify",
    "ai:mcp": "node backend/ai-mcp-dev.js",
    "ai:mcp:fixture": "node backend/ai-mcp-dev.js --fixture",
    "dev:smoke": "node scripts/projectamo-dev.mjs smoke",
    "dev:screenshots": "node scripts/projectamo-dev.mjs screenshots",
    "dev:ground-signage-capture": "node scripts/projectamo-dev.mjs ground-signage-capture",
    "demo:repair-weather": "node scripts/repair-demo-weather.mjs",
    "install:browsers:chromium": "npx --prefix frontend playwright install --with-deps chromium",
    "install:browsers:webkit": "npx --prefix frontend playwright install --with-deps webkit",
    "install:prototype": "npm --prefix prototypes/destination-weather-comparison ci",
    "build": "npm run build --prefix frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:shared": "node --test shared/*.test.js",
    "test:offline": "npm run test:shared && node --test scripts/projectamo-dev.test.mjs scripts/installation-contract.test.mjs && node --test deploy/test-nginx-rate-limit.mjs && bash deploy/test-deploy-lock.sh && bash deploy/test-atomic-exchange.sh && bash deploy/test-build-frontend-retention.sh",
    "test:python:unittest": "python3 -m unittest discover -s scripts -p 'test_aip_enr*_poc.py'",
    "test:python:main": "python3 scripts/test_build_aip_change_candidates.py && python3 scripts/test_inspect_airac_amendment.py",
    "test:prototype": "npm --prefix prototypes/destination-weather-comparison run build && npm --prefix prototypes/destination-weather-comparison run test:sites",
    "test": "npm run test:backend && npm run test:frontend && npm run test:offline",
    "check": "npm test && npm run build",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "@turf/turf": "^7.3.5",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@turf/union": "^7.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  }
}
